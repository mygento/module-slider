<?php
/** @var \Mygento\Slider\Block\BannerSlider $block */
/** @var \Magento\Framework\Escaper $escaper */
$images = $block->getImages();
$options = $block->getOptions();
$sliderIdentifier = $block->getSliderIdentifier();
$title = $block->getTitle();
$breakpoint = $options['breakpoint'] ?? 1024;
$lazy = $options['lazyLoad'] ?? false;
$width = $block->getIntegerOption($options, 'width');
$height = $block->getIntegerOption($options, 'height');
$widthS = $block->getIntegerOption($options, 'width_small');
$heightS = $block->getIntegerOption($options, 'height_small');

$widthTag = $width !== null ? ' width="' . $width . '"' : '';
$heightTag = $height !== null ? ' height="' . $height . '"' : '';

$widthSTag = $widthS !== null ? ' width="' . $widthS . '"' : '';
$heightSTag = $heightS !== null ? ' height="' . $heightS . '"' : '';

$thumbWidth = $block->getIntegerOption($options, 'thumbnails_width');
$thumbHeight = $block->getIntegerOption($options, 'thumbnails_height');

$thumbWidthTag  = $thumbWidth  !== null ? ' width="' . $thumbWidth . '"' : '';
$thumbHeightTag = $thumbHeight !== null ? ' height="' . $thumbHeight . '"' : '';
?>
<?php if (count($images) === 1): ?>
<div id="<?= $escaper->escapeHtmlAttr($sliderIdentifier) ?>" aria-label="<?= $escaper->escapeHtmlAttr($title) ?>">
<?php foreach ($images as $img): ?>
<?php $hasLink = isset($img['link']) &&  '' !== trim($img['link']); ?>
<?php if ($hasLink): ?>
    <a href="<?= $escaper->escapeUrl($img['link']) ?>">
<?php endif; ?>
        <picture>
<?php foreach ($img['image_formats'] as $type => $item): ?>
<?php
    $hasSmall = isset($item['small_image']) && !empty($item['small_image']['url']);
    $mq = $hasSmall ? ' media="(min-width: ' . $breakpoint . 'px)"' : '';
    $mqS = $hasSmall ? ' media="(max-width: ' . ($breakpoint - 1) . 'px)"' : '';
    ?>
            <source<?= $widthTag ?><?= $heightTag ?><?= $mq ?> srcset="<?= $escaper->escapeUrl($item['image']['srcset']) ?>" type="image/<?= $type ?>" />
<?php if ($hasSmall): ?>
            <source<?= $widthSTag ?><?= $heightSTag ?><?= $mqS ?> srcset="<?= $escaper->escapeUrl($item['small_image']['srcset']) ?>" type="image/<?= $type ?>" />
<?php endif; ?>
<?php endforeach; ?>
            <img alt="<?= $escaper->escapeHtmlAttr($img['name']) ?>" src="<?= $escaper->escapeUrl($img['default']) ?>" fetchpriority="<?= $lazy ? 'low' : 'high' ?>"<?= $lazy ? ' loading="lazy"' : '' ?><?= $widthTag ?><?= $heightTag ?> />
        </picture>
<?php if ($hasLink): ?>
    </a>
<?php endif; ?>
<?php endforeach; ?>
</div>
<?php endif; ?>
<?php if (count($images) > 1): ?>
<section class="splide" id="<?= $escaper->escapeHtmlAttr($sliderIdentifier) ?>" aria-label="<?= $escaper->escapeHtmlAttr($title) ?>">
    <div class="splide__track">
        <ul class="splide__list">
<?php foreach ($images as $index => $img): ?>
<?php $hasLink = isset($img['link']) &&  '' !== trim($img['link']); ?>
<?php $content = (string) ($img['content'] ?? ''); ?>
            <li class="splide__slide">
<?php if ($hasLink): ?>
                <a href="<?= $escaper->escapeUrl($img['link']) ?>">
<?php endif; ?>
                    <picture>
<?php foreach ($img['image_formats'] as $type => $item): ?>
<?php
    $hasSmall = isset($item['small_image']) && !empty($item['small_image']['url']);
    $mq = $hasSmall ? ' media="(min-width: ' . $breakpoint . 'px)"' : '';
    $mqS = $hasSmall ? ' media="(max-width: ' . ($breakpoint - 1) . 'px)"' : '';
    ?>
                        <source<?= $widthTag ?><?= $heightTag ?><?= $mq ?> srcset="<?= $escaper->escapeUrl($item['image']['srcset']) ?>" type="image/<?= $type ?>" />
<?php if ($hasSmall): ?>
                        <source<?= $widthSTag ?><?= $heightSTag ?><?= $mqS ?> srcset="<?= $escaper->escapeUrl($item['small_image']['srcset']) ?>" type="image/<?= $type ?>" />
<?php endif; ?>
<?php endforeach; ?>
                        <img alt="<?= $escaper->escapeHtmlAttr($img['name']) ?>" src="<?= $escaper->escapeUrl($img['default']) ?>" fetchpriority="<?= ($lazy || $index !== 0) ? 'low' : 'high' ?>"<?= ($lazy || $index !== 0) ? ' loading="lazy"' : '' ?><?= $widthTag ?><?= $heightTag ?> />
                    </picture>
<?php if ($hasLink): ?>
                </a>
<?php endif; ?>
<?php if ($content !== ''): ?>
                <?= /* @noEscape */ $content . PHP_EOL ?>
<?php endif; ?>
            </li>
<?php endforeach; ?>
        </ul>
    </div>
</section>
<?php if ($block->hasThumbnails()): ?>
<section id="thumbnail-<?= $escaper->escapeHtmlAttr($sliderIdentifier) ?>" class="splide">
    <div class="splide__track">
        <ul class="splide__list">
<?php foreach ($images as $index => $img): ?>
<?php
    $hasThumbSmall = !empty($img['small_image']);
    $thumbSrc = $img['image'] ?? $img['default'];
    $thumbMq  = $hasThumbSmall ? ' media="(min-width: ' . $breakpoint . 'px)"' : '';
    $thumbMqS = $hasThumbSmall ? ' media="(max-width: ' . ($breakpoint - 1) . 'px)"' : '';
    ?>
            <li class="splide__slide">
                <picture>
<?php if (!empty($img)): ?>
<?php if ($hasThumbSmall): ?>
                    <source<?= $thumbWidthTag ?><?= $thumbHeightTag ?><?= $thumbMqS ?> srcset="<?= $escaper->escapeUrl($img['small_image']) ?>" type="image/jpeg" />
<?php endif; ?>
                    <source<?= $thumbWidthTag ?><?= $thumbHeightTag ?><?= $thumbMq ?> srcset="<?= $escaper->escapeUrl($thumbSrc) ?>" type="image/jpeg" />
<?php endif; ?>
                    <img src="<?= $escaper->escapeUrl($img['default']) ?>" alt="<?= $escaper->escapeHtmlAttr($img['name']) ?>"<?= $thumbWidthTag ?><?= $thumbHeightTag ?> loading="lazy" />
                </picture>
            </li>
<?php endforeach; ?>
        </ul>
    </div>
</section>
<?php endif; ?>
<script type="text/x-magento-init">
    {
        "#<?= $escaper->escapeJs($sliderIdentifier) ?>": {
            "Mygento_Slider/js/banner_slider": {
                "arrows": <?= ($options['arrows'] ?? true) ? 'true' : 'false' ?>,
                "autoplay": <?= ($options['autoplay'] ?? true) ? 'true' : 'false' ?>,
                "pagination": <?= ($options['dots'] ?? true) ? 'true' : 'false' ?>,
                "interval": <?= (int) ($options['autoplay_interval'] ?? 4000) ?>,
                "perPage": <?= (int) ($options['per_page'] ?? 1) ?>,
<?php if ($block->hasThumbnails()): ?>
                "thumbnailsElement": "#thumbnail-<?= $escaper->escapeJs($sliderIdentifier) ?>",
                "thumbnails": <?= $block->getThumbnailsOptions() ?>,
<?php endif; ?>
                "type": "<?= ($options['infinite'] ?? true) ? 'loop' : 'slide' ?>"
            }
        }
    }
</script>
<?php endif; ?>
