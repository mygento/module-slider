{
  "name": "mygento/module-slider",
  "description": "Magento 2 Slider Module",
  "type": "magento2-module",
  "license": "OSL-3.0",
  "authors": [
    {
      "name": "Nikita Tarasov",
      "email": "nikita@mygento.com"
    }
  ],
  "keywords": [
    "magento",
    "magento2",
    "mygento"
  ],
  "require": {
    "magento/module-backend": "102.*",
    "mygento/module-base": "~2.4.0",
    "magento/module-catalog-widget": "100.4.*",
    "mygento/module-image-common": "v2.4.x-dev"
  },
  "require-dev": {
    "mygento/coding-standard": "~2.14.8"
  },
  "autoload": {
    "files": [
      "registration.php"
    ],
    "psr-4": {
      "Mygento\\Slider\\": ""
    }
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://repo.magento.com"
    }
  ],
  "config": {
    "allow-plugins": {
      "magento/composer-dependency-version-audit-plugin": false,
      "magento/magento-composer-installer": false,
      "phpro/grumphp": true
    }
  }
}
