<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <virtualType name="Mygento\Slider\Model\ProductResizer" type="Mygento\Slider\Model\Resizer">
        <arguments>
            <argument name="basePath" xsi:type="string">catalog/product</argument>
        </arguments>
    </virtualType>
    <type name="Mygento\Slider\Model\DataBuilder\ProductSliderDataBuilder">
        <arguments>
            <argument name="imageBuilder" xsi:type="object">Mygento\Slider\Model\DataBuilder\ProductImageBuilder</argument>
        </arguments>
    </type>
    <virtualType name="Mygento\Slider\Model\DataBuilder\ProductImageBuilder" type="Mygento\Slider\Model\DataBuilder\ImageBuilder">
        <arguments>
            <argument name="service" xsi:type="object">Mygento\Slider\Model\ProductResizer</argument>
        </arguments>
    </virtualType>
</config>
