<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Mygento_Slider::root" title="Mygento Slider" translate="title">
                    <resource id="Mygento_Slider::productslider" title="Product Slider" translate="title"/>
                    <resource id="Mygento_Slider::slider" title="Slider" translate="title"/>
                    <resource id="Mygento_Slider::banner" title="Banner" translate="title"/>
                </resource>
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="Mygento_Slider::config" title="Mygento Slider" translate="title"/>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
