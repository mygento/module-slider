<?xml version="1.0" ?>
<widgets xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Widget:etc/widget.xsd">
    <widget class="Mygento\Slider\Block\BannerSlider" id="mygento_banner_slider_widget">
        <label translate="true">Mygento Banner Slider</label>
        <description translate="true">Mygento Banner Slider</description>
        <parameters>
            <parameter name="identity" sort_order="10" required="true" visible="true" xsi:type="select" source_model="Mygento\Slider\Model\Config\Source\BannerSliderList">
                <label>Select Banner Slider</label>
            </parameter>
        </parameters>
    </widget>
    <widget class="Mygento\Slider\Block\ProductSlider" id="mygento_banner_slider_product_widget">
        <label translate="true">Mygento Product Slider</label>
        <description translate="true">Mygento Product Slider</description>
        <parameters>
            <parameter name="identity" sort_order="10" required="true" visible="true" xsi:type="select" source_model="Mygento\Slider\Model\Config\Source\ProductSliderList">
                <label>Select Product Slider</label>
            </parameter>
        </parameters>
    </widget>
    <widget class="Mygento\Slider\Block\CategoryProductSlider" id="mygento_banner_slider_category_product_widget">
        <label translate="true">Mygento Category Product Slider</label>
        <description translate="true">Mygento Category Product Slider</description>
        <parameters>
            <parameter name="id_path" xsi:type="block" visible="true" required="true" sort_order="10">
                <label translate="true">Category</label>
                <block class="Magento\Catalog\Block\Adminhtml\Category\Widget\Chooser">
                    <data>
                        <item name="button" xsi:type="array">
                            <item name="open" xsi:type="string" translate="true">Select Category...</item>
                        </item>
                    </data>
                </block>
            </parameter>
            <parameter name="products_count" xsi:type="text" required="true" visible="true">
                <label translate="true">Number of Products to Display</label>
                <value>10</value>
            </parameter>
            <parameter name="content_text" xsi:type="block" visible="true" sort_order="70" >
                <label translate="true"> Content</label>
                <description><![CDATA[Html content can be added here]]></description>
                <block class="Mygento\Slider\Block\Adminhtml\Widget\TextArea" />
            </parameter>
            <parameter name="sort_by" sort_order="10" required="true" visible="true" xsi:type="select" source_model="Mygento\Slider\Model\Catalog\Sorting\Options">
                <label>Sort By</label>
            </parameter>
            <parameter name="jpg" xsi:type="select" visible="true" sort_order="40" source_model="Magento\Config\Model\Config\Source\Yesno">
                <label translate="true">Enables jpg Images</label>
            </parameter>
            <parameter name="webp" xsi:type="select" visible="true" sort_order="40" source_model="Magento\Config\Model\Config\Source\Yesno">
                <label translate="true">Enables webp Images</label>
            </parameter>
            <parameter name="avif" xsi:type="select" visible="true" sort_order="40" source_model="Magento\Config\Model\Config\Source\Yesno">
                <label translate="true">Enables avif Images</label>
            </parameter>
        </parameters>
    </widget>
</widgets>