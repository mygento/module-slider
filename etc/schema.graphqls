type Slider {
    title: String!
    identity: String!
    options: SliderOptions!
    banners: [Banner!]! @doc(description: "List of banners in the slider")
}

type SliderOptions {
    dots: Boolean!
    arrows: Boolean!
    preload: Boolean!
    autoplay: Boolean!
    infinite: Boolean!
    lazyLoad: Boolean!
    width: Int
    height: Int
    per_page: Int!
    breakpoint: Int!
    width_small: Int
    height_small: Int
    autoplay_interval: Int!
}

type Banner {
    uid: ID!
    link: String
    image: String!
    small_image: String
    name: String!
    entity_type: String!
    entity_identifier: ID
    image_formats: SliderImageFormats! @doc(description: "List image formats")
}

type SliderImageFormats {
    avif: ImageFormatData
    webp: ImageFormatData
    jpg: ImageFormatData
}

type ImageFormatData {
    image: ImageData!
    small_image: ImageData
}

type ImageData {
  srcset: String!
  url: String!
  list: [ImageVariant!]!
  lqip: String
}

type ImageVariant {
    url: String!
    width: Int!
}

type ProductSlider {
    title: String!
    identity: String!
    options: ProductSliderOptions!
    parameters: ProductSliderParameters!
    items: [SliderProduct]
}

type SliderProduct @doc(description: "Contains product details") {
    product: ProductInterface! @doc(description: "Product.") @resolver(class: "Magento\\CatalogGraphQl\\Model\\Resolver\\Product")
    image_formats: ImageFormats! @doc(description: "List image formats")
    image: String!
}

type ImageFormats {
    avif: ImageData
    webp: ImageData
    jpg: ImageData
}

type ProductSliderOptions {
    dots: Boolean!
    arrows: Boolean!
    autoplay: Boolean!
    infinite: Boolean!
    lazyLoad: Boolean!
    per_page: Int!
    per_move: Int!
    autoplay_interval: Int!
}

type ProductSliderParameters {
    products_count: Int!
    sort_order: String!
    breakpoints: [Breakpoints]
}

type Breakpoints {
    width: Int
    per_page: Int
}

type Query {
    slider(
        identity: String!,
    ): Slider @resolver(class: "Mygento\\Slider\\Model\\Resolver\\Slider")

    productSlider(
        identity: String!,
    ): ProductSlider @resolver(class: "Mygento\\Slider\\Model\\Resolver\\ProductSlider")
}